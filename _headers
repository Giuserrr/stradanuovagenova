# Cache statico immutabile (hashing-friendly)
# I file in /assets/ e /img/ non cambiano nome → safe immutable.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# Sitemap e file tecnici: cache breve, vanno revalidati spesso

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# Security headers globali (tutte le risposte)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains
